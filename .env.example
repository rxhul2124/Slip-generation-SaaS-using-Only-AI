# ─── Core ───
NODE_ENV=development
PORT=5000

# ─── Database ───
# MongoDB connection string (required in production)
MONGODB_URI=mongodb://localhost:27017/slipora

# ─── URLs ───
# Comma-separated list of allowed web origins for CORS
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000/api/v1

# ─── Secrets (must be 32+ chars in production) ───
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-another-long-random-secret-at-least-32-chars
COOKIE_SECRET=replace-with-cookie-secret-at-least-32-chars-long
CSRF_SECRET=replace-with-csrf-secret-at-least-32-chars-long

# ─── Auth ───
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ─── Payments: Razorpay ───
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Payments: Stripe (optional) ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── AI / Image analysis (optional) ───
GEMINI_API_KEY=

# ─── Email (optional) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Slipora <no-reply@slipora.local>

# ─── Cloudinary (optional) ───
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── AWS S3 (optional) ───
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# ─── Frontend (Vite) ───
# Set this to your deployed API URL in production
VITE_API_URL=/api/v1
